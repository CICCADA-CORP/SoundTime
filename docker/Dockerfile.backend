FROM rust:1.97-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy only manifests + lockfile to cache dependency compilation
COPY Cargo.toml Cargo.lock ./
COPY crates/soundtime-server/Cargo.toml crates/soundtime-server/Cargo.toml
COPY crates/soundtime-audio/Cargo.toml crates/soundtime-audio/Cargo.toml
COPY crates/soundtime-db/Cargo.toml crates/soundtime-db/Cargo.toml
COPY crates/soundtime-migration/Cargo.toml crates/soundtime-migration/Cargo.toml
COPY crates/soundtime-p2p/Cargo.toml crates/soundtime-p2p/Cargo.toml
COPY crates/soundtime-plugin/Cargo.toml crates/soundtime-plugin/Cargo.toml

# 2. Create stub lib.rs / main.rs so cargo can resolve the workspace
RUN mkdir -p crates/soundtime-server/src && echo "fn main() {}" > crates/soundtime-server/src/main.rs \
    && mkdir -p crates/soundtime-audio/src && echo "" > crates/soundtime-audio/src/lib.rs \
    && mkdir -p crates/soundtime-db/src && echo "" > crates/soundtime-db/src/lib.rs \
    && mkdir -p crates/soundtime-migration/src && echo "" > crates/soundtime-migration/src/lib.rs \
    && mkdir -p crates/soundtime-p2p/src && echo "" > crates/soundtime-p2p/src/lib.rs \
    && mkdir -p crates/soundtime-plugin/src && echo "" > crates/soundtime-plugin/src/lib.rs

# 3. Build only dependencies (this layer is cached unless Cargo.toml/lock changes)
ARG CARGO_BUILD_JOBS
RUN cargo build --locked --release -p soundtime-server --features redis
RUN rm -rf crates/*/src

# 4. Copy real source code
COPY . ./

# 5. Touch files so cargo knows they changed, then build with version
# A new build number only invalidates the application build.
ARG SOUNDTIME_BUILD_NUMBER=""
ENV SOUNDTIME_BUILD_NUMBER=${SOUNDTIME_BUILD_NUMBER}
RUN find crates -name "*.rs" -exec touch {} + \
    && cargo build --locked --release -p soundtime-server --features redis

# Built only when the federation integration harness requests its own target.
FROM builder AS federation-fixture-builder
RUN cargo build --locked --release -p soundtime-server --features redis --example federation_upgrade

FROM federation-fixture-builder AS federation-rust-tests
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN cargo test --locked --release --workspace --features soundtime-server/redis --lib --bins --tests --no-run

# Keep the official relay binary out of the production image. Match the iroh
# wire protocol pinned in Cargo.lock and build with its published crate lock.
FROM builder AS federation-relay-builder
RUN cargo install --locked --version '=1.5.0' --features server --bin iroh-relay --root /opt/relay iroh-relay

FROM debian:trixie-slim AS federation-relay
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=federation-relay-builder /opt/relay/bin/iroh-relay /usr/local/bin/iroh-relay
USER nobody
ENTRYPOINT ["/usr/local/bin/iroh-relay"]
CMD ["--dev"]

FROM debian:trixie-slim AS runtime

RUN apt-get update && apt-get install -y ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*
RUN useradd -m appuser

WORKDIR /app

COPY --from=builder /app/target/release/soundtime-server /app/soundtime-server

RUN mkdir -p /data/music /data/p2p-blobs && chown -R appuser:appuser /data

ENV SOUNDTIME_ENV=production

USER appuser

EXPOSE 8080

CMD ["/app/soundtime-server"]

FROM runtime AS federation-fixture
COPY --from=federation-fixture-builder /app/target/release/examples/federation_upgrade /app/federation_upgrade
ENTRYPOINT ["/app/federation_upgrade"]
CMD []

FROM runtime AS production
