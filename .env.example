# ─── Database ───
DATABASE_URL=postgres://soundtime:soundtime_secure_password@localhost:5432/soundtime
POSTGRES_USER=soundtime
POSTGRES_PASSWORD=soundtime_secure_password
POSTGRES_DB=soundtime

# ─── Redis (Optional) ─────────────────────
# When set, enables real-time trending, caching, and session features
# If not set, the application falls back to PostgreSQL for all queries
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── Application ───
# The domain where the app is hosted (used for P2P identity and links)
SOUNDTIME_DOMAIN=localhost
HOST=0.0.0.0
PORT=8080

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info,soundtime=debug

# ─── Security ───
# Must be generated with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars
# Token expiration in minutes (default: 15)
JWT_EXPIRATION=15
# Refresh token expiration in days (default: 7)
REFRESH_EXPIRATION=7

# ─── Storage ───
# Path to store uploaded audio files and waveforms
AUDIO_STORAGE_PATH=./data/music

# Optional read-only network music source for Docker on Linux.
# Enable the appropriate COMPOSE_FILE in .env; see docs/deployment.md.
# COMPOSE_FILE=docker-compose.yml:docker/compose.nfs.yml
# NFS_SERVER=192.0.2.10
# NFS_EXPORT=/music
# COMPOSE_FILE=docker-compose.yml:docker/compose.smb.yml
# SMB_SERVER=192.0.2.10
# SMB_SHARE=music
# SMB_USERNAME=soundtime-reader
# SMB_PASSWORD='replace-with-share-password'

# ─── Networking ───
# Iroh P2P listening port
P2P_BIND_PORT=11204
# Enable/disable the P2P node
P2P_ENABLED=true
# Persistent secret key path (ensures stable NodeId across restarts)
# P2P_SECRET_KEY_PATH=./data/p2p/secret_key
# Enable local network discovery (mDNS)
P2P_LOCAL_DISCOVERY=true
# Optional shared directory for discovering SoundTime peers by NodeId.
# Use the same trusted HTTPS endpoint on each participating instance.
# P2P_RENDEZVOUS_URL=https://music.example.org/api/p2p/rendezvous
# Enable only on an instance hosting the directory.
P2P_RENDEZVOUS_SERVER=false
# Comma-separated NodeIds of seed peers to connect to on startup.
# Your instance will auto-connect to these peers and replicate tracks.
# Get the NodeId of another instance from its Admin → P2P panel.
# P2P_SEED_PEERS=abc123deadbeef,def456cafebabe

# ─── Frontend (dev only) ───
# Override API URL for local dev WITHOUT Vite proxy.
# In production behind Nginx, leave unset — relative "/api" is used automatically.
# PUBLIC_API_URL=http://localhost:8080/api
